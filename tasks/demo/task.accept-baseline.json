{
  "version": 1,
  "accept_baseline": true,
  "steps": [
    {
      "cmd": "date",
      "args": ["-u", "+%Y-%m-%dT%H:%M:%SZ"],
      "stdout_path": "/work/out/run3/utc.txt",
      "note": "baseline acceptance demo (note field included)"
    },
    {
      "cmd": "sha256sum",
      "args": ["/work/out/run3/utc.txt"],
      "stdout_path": "/work/out/run3/utc.txt.sha256"
    },
    {
      "cmd": "ls",
      "args": ["-la", "/work/memory"],
      "stdout_path": "/work/out/run3/ls-memory.txt"
    }
  ]
}

